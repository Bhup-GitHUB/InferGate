FROM oven/bun:1.3.5-slim AS base
WORKDIR /app
COPY package.json bun.lock tsconfig.json ./
COPY apps/gateway/package.json ./apps/gateway/
COPY apps/web/package.json ./apps/web/
COPY packages/auth/package.json ./packages/auth/
COPY packages/schemas/package.json ./packages/schemas/
COPY packages/providers/package.json ./packages/providers/
COPY packages/db/package.json ./packages/db/
COPY packages/ratelimit/package.json ./packages/ratelimit/
COPY packages/otel/package.json ./packages/otel/
COPY packages/routing/package.json ./packages/routing/
COPY packages/billing/package.json ./packages/billing/
COPY packages/cache/package.json ./packages/cache/
COPY packages/scheduler/package.json ./packages/scheduler/
COPY packages/webhooks/package.json ./packages/webhooks/
COPY packages/client/package.json ./packages/client/
COPY services/billing-worker/package.json ./services/billing-worker/
COPY services/health-prober/package.json ./services/health-prober/
RUN bun install --frozen-lockfile
COPY . .
ENV PORT=3000
EXPOSE 3000
CMD ["bun", "run", "apps/gateway/src/index.ts"]
